# Study Reviewer — Environment Variables Configuration

# Aplicação
APP_NAME="Study Reviewer"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Chave Criptográfica AES-256-GCM (32 bytes para produção)
SECRET_KEY="super-secret-key-study-reviewer-32b-length!"

# Banco de Dados
# Desenvolvimento local (Docker Compose):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/study_reviewer"

# Desenvolvimento local rápido (SQLite):
# DATABASE_URL="sqlite:///./study_reviewer.db"

# Produção (Neon Serverless PostgreSQL):
# DATABASE_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/study_reviewer?sslmode=require"

# Study Reviewer — Offline Environment Variables Configuration

# Aplicação
APP_NAME="Study Reviewer"
ENVIRONMENT="development"
DEBUG=False
HOST="0.0.0.0"
PORT=8000

# Chave Criptográfica AES-256-GCM (substitua por uma chave segura de 32+ caracteres em produção)
SECRET_KEY="change-me-to-a-secure-random-secret-key-32-chars"

# Banco de Dados (padrão 100% local com SQLite)
DATABASE_URL="sqlite:///./study_reviewer.db"

# Opcional: PostgreSQL local
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/study_reviewer"

# Opcional: Redis local para cache/sessões (caso omitido/indisponível, usa fallback local)
# REDIS_URL="redis://localhost:6379/0"
